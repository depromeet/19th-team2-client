branch=$(git rev-parse --abbrev-ref HEAD)
pattern='^(feat|fix|chore|docs|refactor)/[a-z0-9][a-z0-9._-]*$'

# main은 PR(squash merge)로만 갱신한다
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✖ main에 직접 push할 수 없습니다. 기능 브랜치에서 PR을 만들어 주세요."
    exit 1
  fi
done

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "✖ 브랜치 이름 규칙 위반: '$branch'"
  echo "  형식: feat|fix|chore|docs|refactor/설명 (소문자 kebab-case, 예: feat/group-buy-detail)"
  echo "  이름 변경: git branch -m <새-이름>"
  exit 1
fi
